<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcSamplingSiteMapper">

    <resultMap type="GcSamplingSite" id="GcSamplingSiteResult">
        <id     property="siteId"              column="site_id"              />
        <result property="siteName"            column="site_name"            />
        <result property="regionId"            column="region_id"            />
        <result property="address"             column="address"              />
        <result property="streetManagerId"     column="street_manager_id"    />
        <result property="streetManagerName"   column="street_manager_name"  />
        <result property="streetManagerPhone"  column="street_manager_phone" />
        <result property="siteManagerId"       column="site_manager_id"      />
        <result property="siteManagerName"     column="site_manager_name"    />
        <result property="siteManagerPhone"    column="site_manager_phone"   />
        <result property="status"              column="status"               />
        <result property="regionName"          column="region_name"          />
        <result property="createBy"            column="create_by"            />
        <result property="createTime"          column="create_time"          />
        <result property="updateBy"            column="update_by"            />
        <result property="updateTime"          column="update_time"          />
        <result property="remark"              column="remark"               />
    </resultMap>

    <sql id="selectSamplingSiteVo">
        select s.site_id, s.site_name, s.region_id, s.address,
               s.street_manager_id, s.street_manager_name, s.street_manager_phone,
               s.site_manager_id, s.site_manager_name, s.site_manager_phone,
               s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               r.region_name
        from gc_sampling_site s
        left join gc_region r on s.region_id = r.region_id
    </sql>

    <select id="selectSamplingSiteList" parameterType="GcSamplingSite" resultMap="GcSamplingSiteResult">
        <include refid="selectSamplingSiteVo"/>
        where 1=1
        <if test="siteName != null and siteName != ''">
            AND s.site_name like concat('%', #{siteName}, '%')
        </if>
        <if test="regionId != null">
            AND s.region_id = #{regionId}
        </if>
        <if test="status != null and status != ''">
            AND s.status = #{status}
        </if>
        order by s.create_time desc
    </select>

    <select id="selectSamplingSiteById" parameterType="Long" resultMap="GcSamplingSiteResult">
        <include refid="selectSamplingSiteVo"/>
        where s.site_id = #{siteId}
    </select>

    <select id="selectSamplingSiteOptions" resultMap="GcSamplingSiteResult">
        select site_id, site_name from gc_sampling_site
        where status = '0'
        <if test="regionId != null">
            AND region_id = #{regionId}
        </if>
        order by site_name
    </select>

    <select id="checkSiteExistResident" parameterType="Long" resultType="int">
        select count(1) from gc_resident where appointment_site_id = #{siteId}
    </select>

    <insert id="insertSamplingSite" parameterType="GcSamplingSite" useGeneratedKeys="true" keyProperty="siteId">
        insert into gc_sampling_site(
            <if test="siteName != null and siteName != ''">site_name,</if>
            <if test="regionId != null">region_id,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="streetManagerId != null">street_manager_id,</if>
            <if test="streetManagerName != null and streetManagerName != ''">street_manager_name,</if>
            <if test="streetManagerPhone != null and streetManagerPhone != ''">street_manager_phone,</if>
            <if test="siteManagerId != null">site_manager_id,</if>
            <if test="siteManagerName != null and siteManagerName != ''">site_manager_name,</if>
            <if test="siteManagerPhone != null and siteManagerPhone != ''">site_manager_phone,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="siteName != null and siteName != ''">#{siteName},</if>
            <if test="regionId != null">#{regionId},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="streetManagerId != null">#{streetManagerId},</if>
            <if test="streetManagerName != null and streetManagerName != ''">#{streetManagerName},</if>
            <if test="streetManagerPhone != null and streetManagerPhone != ''">#{streetManagerPhone},</if>
            <if test="siteManagerId != null">#{siteManagerId},</if>
            <if test="siteManagerName != null and siteManagerName != ''">#{siteManagerName},</if>
            <if test="siteManagerPhone != null and siteManagerPhone != ''">#{siteManagerPhone},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateSamplingSite" parameterType="GcSamplingSite">
        update gc_sampling_site
        <set>
            <if test="siteName != null and siteName != ''">site_name = #{siteName},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="streetManagerId != null">street_manager_id = #{streetManagerId},</if>
            <if test="streetManagerName != null">street_manager_name = #{streetManagerName},</if>
            <if test="streetManagerPhone != null">street_manager_phone = #{streetManagerPhone},</if>
            <if test="siteManagerId != null">site_manager_id = #{siteManagerId},</if>
            <if test="siteManagerName != null">site_manager_name = #{siteManagerName},</if>
            <if test="siteManagerPhone != null">site_manager_phone = #{siteManagerPhone},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where site_id = #{siteId}
    </update>

    <delete id="deleteSamplingSiteById" parameterType="Long">
        delete from gc_sampling_site where site_id = #{siteId}
    </delete>

</mapper>
