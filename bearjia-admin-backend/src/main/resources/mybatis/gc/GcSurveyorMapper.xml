<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcSurveyorMapper">

    <resultMap type="GcSurveyor" id="GcSurveyorResult">
        <id     property="surveyorId"          column="surveyor_id"          />
        <result property="userId"              column="user_id"              />
        <result property="realName"            column="real_name"            />
        <result property="gender"              column="gender"               />
        <result property="regionId"            column="region_id"            />
        <result property="streetManagerId"     column="street_manager_id"    />
        <result property="streetManagerPhone"  column="street_manager_phone" />
        <result property="phoneNumber"         column="phone_number"         />
        <result property="status"              column="status"               />
        <result property="regionName"          column="region_name"          />
        <result property="streetManagerName"   column="street_manager_name"  />
        <result property="createBy"            column="create_by"            />
        <result property="createTime"          column="create_time"          />
        <result property="updateBy"            column="update_by"            />
        <result property="updateTime"          column="update_time"          />
        <result property="remark"              column="remark"               />
    </resultMap>

    <resultMap type="SurveyorPerformanceVO" id="SurveyorPerformanceResult">
        <result property="surveyorId"          column="surveyor_id"          />
        <result property="surveyorName"        column="surveyor_name"        />
        <result property="regionName"          column="region_name"          />
        <result property="residentCount"       column="resident_count"       />
        <result property="questionnaireCount"  column="questionnaire_count"  />
        <result property="focusGroupCount"     column="focus_group_count"    />
    </resultMap>

    <sql id="selectSurveyorVo">
        select s.surveyor_id, s.user_id, s.real_name, s.gender, s.region_id,
               s.street_manager_id, s.street_manager_phone, s.phone_number, s.status,
               s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               r.region_name
        from gc_surveyor s
        left join gc_region r on s.region_id = r.region_id
    </sql>

    <select id="selectSurveyorList" parameterType="GcSurveyor" resultMap="GcSurveyorResult">
        <include refid="selectSurveyorVo"/>
        where 1=1
        <if test="realName != null and realName != ''">
            AND s.real_name like concat('%', #{realName}, '%')
        </if>
        <if test="regionId != null">
            AND s.region_id = #{regionId}
        </if>
        <if test="status != null and status != ''">
            AND s.status = #{status}
        </if>
        order by s.create_time desc
    </select>

    <select id="selectSurveyorById" parameterType="Long" resultMap="GcSurveyorResult">
        <include refid="selectSurveyorVo"/>
        where s.surveyor_id = #{surveyorId}
    </select>

    <select id="checkUserIdUnique" resultMap="GcSurveyorResult">
        select surveyor_id, user_id from gc_surveyor
        where user_id = #{userId}
        <if test="surveyorId != null">
            and surveyor_id != #{surveyorId}
        </if>
        limit 1
    </select>

    <select id="checkSurveyorExistResident" parameterType="Long" resultType="int">
        select count(1) from gc_resident where surveyor_id = #{surveyorId}
    </select>

    <select id="selectSurveyorPerformance" resultMap="SurveyorPerformanceResult">
        select 
            s.surveyor_id,
            s.real_name as surveyor_name,
            r.region_name,
            count(distinct res.resident_id) as resident_count,
            count(distinct qr.record_id) as questionnaire_count,
            sum(case when res.is_focus_group = 1 then 1 else 0 end) as focus_group_count
        from gc_surveyor s
        left join gc_region r on s.region_id = r.region_id
        left join gc_resident res on s.surveyor_id = res.surveyor_id
        left join gc_questionnaire_record qr on s.surveyor_id = qr.surveyor_id
        where s.status = '0'
        <if test="regionId != null">
            AND s.region_id = #{regionId}
        </if>
        <if test="startDate != null and endDate != null">
            AND (res.create_time between #{startDate} and #{endDate}
                 or qr.create_time between #{startDate} and #{endDate})
        </if>
        group by s.surveyor_id, s.real_name, r.region_name
        order by resident_count desc
    </select>

    <insert id="insertSurveyor" parameterType="GcSurveyor" useGeneratedKeys="true" keyProperty="surveyorId">
        insert into gc_surveyor(
            <if test="userId != null">user_id,</if>
            <if test="realName != null and realName != ''">real_name,</if>
            <if test="gender != null and gender != ''">gender,</if>
            <if test="regionId != null">region_id,</if>
            <if test="streetManagerId != null">street_manager_id,</if>
            <if test="streetManagerPhone != null and streetManagerPhone != ''">street_manager_phone,</if>
            <if test="phoneNumber != null and phoneNumber != ''">phone_number,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="userId != null">#{userId},</if>
            <if test="realName != null and realName != ''">#{realName},</if>
            <if test="gender != null and gender != ''">#{gender},</if>
            <if test="regionId != null">#{regionId},</if>
            <if test="streetManagerId != null">#{streetManagerId},</if>
            <if test="streetManagerPhone != null and streetManagerPhone != ''">#{streetManagerPhone},</if>
            <if test="phoneNumber != null and phoneNumber != ''">#{phoneNumber},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateSurveyor" parameterType="GcSurveyor">
        update gc_surveyor
        <set>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="streetManagerId != null">street_manager_id = #{streetManagerId},</if>
            <if test="streetManagerPhone != null">street_manager_phone = #{streetManagerPhone},</if>
            <if test="phoneNumber != null and phoneNumber != ''">phone_number = #{phoneNumber},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where surveyor_id = #{surveyorId}
    </update>

    <delete id="deleteSurveyorById" parameterType="Long">
        delete from gc_surveyor where surveyor_id = #{surveyorId}
    </delete>

</mapper>
