<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcSurveyorMapper">
    
    <resultMap type="com.javaxiaobear.module.gc.domain.entity.GcSurveyor" id="GcSurveyorResult">
        <result property="surveyorId"    column="surveyor_id"    />
        <result property="surveyorName"    column="surveyor_name"    />
        <result property="gender"    column="gender"    />
        <result property="phone"    column="phone"    />
        <result property="idCard"    column="id_card"    />
        <result property="regionId"    column="region_id"    />
        <result property="communityId"    column="community_id"    />
        <result property="siteId"    column="site_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="regionName"    column="region_name"    />
        <result property="communityName"    column="community_name"    />
        <result property="siteName"    column="site_name"    />
    </resultMap>

    <sql id="selectGcSurveyorVo">
        select s.surveyor_id, s.surveyor_name, s.gender, s.phone, s.id_card, s.region_id, s.community_id, 
               s.site_id, s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               r1.region_name as region_name,
               r2.region_name as community_name,
               gs.site_name
        from gc_surveyor s
        left join gc_region r1 on s.region_id = r1.region_id
        left join gc_region r2 on s.community_id = r2.region_id
        left join gc_sampling_site gs on s.site_id = gs.site_id
    </sql>

    <select id="selectGcSurveyorList" parameterType="com.javaxiaobear.module.gc.domain.entity.GcSurveyor" resultMap="GcSurveyorResult">
        <include refid="selectGcSurveyorVo"/>
        <where>  
            <if test="surveyorName != null  and surveyorName != ''"> and s.surveyor_name like concat('%', #{surveyorName}, '%')</if>
            <if test="gender != null  and gender != ''"> and s.gender = #{gender}</if>
            <if test="phone != null  and phone != ''"> and s.phone = #{phone}</if>
            <if test="idCard != null  and idCard != ''"> and s.id_card = #{idCard}</if>
            <if test="regionId != null "> and s.region_id = #{regionId}</if>
            <if test="communityId != null "> and s.community_id = #{communityId}</if>
            <if test="siteId != null "> and s.site_id = #{siteId}</if>
            <if test="status != null  and status != ''"> and s.status = #{status}</if>
        </where>
        order by s.create_time desc
    </select>
    
    <select id="selectGcSurveyorBySurveyorId" parameterType="Long" resultMap="GcSurveyorResult">
        <include refid="selectGcSurveyorVo"/>
        where s.surveyor_id = #{surveyorId}
    </select>
    
    <select id="checkIdCardUnique" resultMap="GcSurveyorResult">
        select surveyor_id, id_card
        from gc_surveyor
        where id_card = #{idCard}
        <if test="surveyorId != null">
            and surveyor_id != #{surveyorId}
        </if>
        limit 1
    </select>

    <insert id="insertGcSurveyor" parameterType="com.javaxiaobear.module.gc.domain.entity.GcSurveyor" useGeneratedKeys="true" keyProperty="surveyorId">
        insert into gc_surveyor
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="surveyorName != null and surveyorName != ''">surveyor_name,</if>
            <if test="gender != null">gender,</if>
            <if test="phone != null">phone,</if>
            <if test="idCard != null">id_card,</if>
            <if test="regionId != null">region_id,</if>
            <if test="communityId != null">community_id,</if>
            <if test="siteId != null">site_id,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="surveyorName != null and surveyorName != ''">#{surveyorName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="phone != null">#{phone},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="regionId != null">#{regionId},</if>
            <if test="communityId != null">#{communityId},</if>
            <if test="siteId != null">#{siteId},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateGcSurveyor" parameterType="com.javaxiaobear.module.gc.domain.entity.GcSurveyor">
        update gc_surveyor
        <trim prefix="SET" suffixOverrides=",">
            <if test="surveyorName != null and surveyorName != ''">surveyor_name = #{surveyorName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="regionId != null">region_id = #{regionId},</if>
            <if test="communityId != null">community_id = #{communityId},</if>
            <if test="siteId != null">site_id = #{siteId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where surveyor_id = #{surveyorId}
    </update>

    <delete id="deleteGcSurveyorBySurveyorId" parameterType="Long">
        delete from gc_surveyor where surveyor_id = #{surveyorId}
    </delete>

    <delete id="deleteGcSurveyorBySurveyorIds" parameterType="String">
        delete from gc_surveyor where surveyor_id in 
        <foreach item="surveyorId" collection="array" open="(" separator="," close=")">
            #{surveyorId}
        </foreach>
    </delete>
</mapper>
