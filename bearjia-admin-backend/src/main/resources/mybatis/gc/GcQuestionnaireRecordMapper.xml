<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcQuestionnaireRecordMapper">
    
    <resultMap type="GcQuestionnaireRecord" id="GcQuestionnaireRecordResult">
        <id     property="recordId"         column="record_id"          />
        <result property="residentId"       column="resident_id"        />
        <result property="templateId"       column="template_id"        />
        <result property="surveyorId"       column="surveyor_id"        />
        <result property="answers"          column="answers"            />
        <result property="riskScore"        column="risk_score"         />
        <result property="isFocusGroup"     column="is_focus_group"     />
        <result property="submitTime"       column="submit_time"        />
        <result property="createSource"     column="create_source"      />
        <result property="createBy"         column="create_by"          />
        <result property="createTime"       column="create_time"        />
        <result property="updateBy"         column="update_by"          />
        <result property="updateTime"       column="update_time"        />
    </resultMap>

    <sql id="selectRecordVo">
        select record_id, resident_id, template_id, surveyor_id, answers,
               risk_score, is_focus_group, submit_time, create_source,
               create_by, create_time, update_by, update_time
        from gc_questionnaire_record
    </sql>

    <select id="selectRecordList" parameterType="GcQuestionnaireRecord" resultMap="GcQuestionnaireRecordResult">
        <include refid="selectRecordVo"/>
        <where>  
            <if test="residentId != null">
                AND resident_id = #{residentId}
            </if>
            <if test="templateId != null">
                AND template_id = #{templateId}
            </if>
            <if test="surveyorId != null">
                AND surveyor_id = #{surveyorId}
            </if>
            <if test="isFocusGroup != null">
                AND is_focus_group = #{isFocusGroup}
            </if>
            <if test="createSource != null and createSource != ''">
                AND create_source = #{createSource}
            </if>
        </where>
        order by submit_time desc
    </select>
    
    <select id="selectRecordById" parameterType="Long" resultMap="GcQuestionnaireRecordResult">
        <include refid="selectRecordVo"/>
        where record_id = #{recordId}
    </select>

    <select id="selectRecordByResidentId" parameterType="Long" resultMap="GcQuestionnaireRecordResult">
        <include refid="selectRecordVo"/>
        where resident_id = #{residentId}
        limit 1
    </select>
        
    <insert id="insertRecord" parameterType="GcQuestionnaireRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into gc_questionnaire_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="residentId != null">resident_id,</if>
            <if test="templateId != null">template_id,</if>
            <if test="surveyorId != null">surveyor_id,</if>
            <if test="answers != null and answers != ''">answers,</if>
            <if test="riskScore != null">risk_score,</if>
            <if test="isFocusGroup != null">is_focus_group,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="createSource != null and createSource != ''">create_source,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="residentId != null">#{residentId},</if>
            <if test="templateId != null">#{templateId},</if>
            <if test="surveyorId != null">#{surveyorId},</if>
            <if test="answers != null and answers != ''">#{answers},</if>
            <if test="riskScore != null">#{riskScore},</if>
            <if test="isFocusGroup != null">#{isFocusGroup},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="createSource != null and createSource != ''">#{createSource},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            now()
        </trim>
    </insert>

    <update id="updateRecord" parameterType="GcQuestionnaireRecord">
        update gc_questionnaire_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="answers != null and answers != ''">answers = #{answers},</if>
            <if test="riskScore != null">risk_score = #{riskScore},</if>
            <if test="isFocusGroup != null">is_focus_group = #{isFocusGroup},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now()
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteRecordById" parameterType="Long">
        delete from gc_questionnaire_record where record_id = #{recordId}
    </delete>

    <delete id="deleteRecordByIds" parameterType="Long">
        delete from gc_questionnaire_record where record_id in
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <select id="countRecord" parameterType="GcQuestionnaireRecord" resultType="int">
        select count(*) from gc_questionnaire_record
        <where>
            <if test="templateId != null">
                AND template_id = #{templateId}
            </if>
            <if test="surveyorId != null">
                AND surveyor_id = #{surveyorId}
            </if>
        </where>
    </select>

    <select id="countRecordBySurveyorId" resultType="int">
        select count(*) from gc_questionnaire_record where surveyor_id = #{surveyorId}
    </select>

</mapper>
