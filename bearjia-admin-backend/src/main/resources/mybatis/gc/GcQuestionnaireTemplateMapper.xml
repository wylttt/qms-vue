<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcQuestionnaireTemplateMapper">
    
    <resultMap type="GcQuestionnaireTemplate" id="GcQuestionnaireTemplateResult">
        <id     property="templateId"       column="template_id"        />
        <result property="templateName"     column="template_name"      />
        <result property="templateCode"     column="template_code"      />
        <result property="version"          column="version"            />
        <result property="description"      column="description"        />
        <result property="templateContent"  column="template_content"   />
        <result property="focusThreshold"   column="focus_threshold"    />
        <result property="status"           column="status"             />
        <result property="createBy"         column="create_by"          />
        <result property="createTime"       column="create_time"        />
        <result property="updateBy"         column="update_by"          />
        <result property="updateTime"       column="update_time"        />
    </resultMap>

    <sql id="selectTemplateVo">
        select template_id, template_name, template_code, version, description,
               template_content, focus_threshold, status, create_by, create_time,
               update_by, update_time
        from gc_questionnaire_template
    </sql>

    <select id="selectTemplateList" parameterType="GcQuestionnaireTemplate" resultMap="GcQuestionnaireTemplateResult">
        <include refid="selectTemplateVo"/>
        <where>  
            <if test="templateName != null and templateName != ''">
                AND template_name like concat('%', #{templateName}, '%')
            </if>
            <if test="templateCode != null and templateCode != ''">
                AND template_code = #{templateCode}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectTemplateById" parameterType="Long" resultMap="GcQuestionnaireTemplateResult">
        <include refid="selectTemplateVo"/>
        where template_id = #{templateId}
    </select>

    <select id="selectTemplateByCode" parameterType="String" resultMap="GcQuestionnaireTemplateResult">
        <include refid="selectTemplateVo"/>
        where template_code = #{templateCode}
    </select>

    <select id="selectEnabledTemplates" resultMap="GcQuestionnaireTemplateResult">
        <include refid="selectTemplateVo"/>
        where status = '1'
        order by create_time desc
    </select>
        
    <insert id="insertTemplate" parameterType="GcQuestionnaireTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into gc_questionnaire_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="templateCode != null and templateCode != ''">template_code,</if>
            <if test="version != null and version != ''">version,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="templateContent != null and templateContent != ''">template_content,</if>
            <if test="focusThreshold != null">focus_threshold,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="templateCode != null and templateCode != ''">#{templateCode},</if>
            <if test="version != null and version != ''">#{version},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="templateContent != null and templateContent != ''">#{templateContent},</if>
            <if test="focusThreshold != null">#{focusThreshold},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            now()
        </trim>
    </insert>

    <update id="updateTemplate" parameterType="GcQuestionnaireTemplate">
        update gc_questionnaire_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="description != null">description = #{description},</if>
            <if test="templateContent != null and templateContent != ''">template_content = #{templateContent},</if>
            <if test="focusThreshold != null">focus_threshold = #{focusThreshold},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now()
        </trim>
        where template_id = #{templateId}
    </update>

    <delete id="deleteTemplateById" parameterType="Long">
        delete from gc_questionnaire_template where template_id = #{templateId}
    </delete>

    <select id="checkTemplateExistRecord" resultType="int">
        select count(*) from gc_questionnaire_record where template_id = #{templateId}
    </select>

</mapper>
