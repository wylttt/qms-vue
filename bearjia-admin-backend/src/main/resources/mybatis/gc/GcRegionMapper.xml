<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaxiaobear.module.gc.mapper.GcRegionMapper">

    <resultMap type="GcRegion" id="GcRegionResult">
        <id     property="regionId"     column="region_id"     />
        <result property="regionName"   column="region_name"   />
        <result property="regionCode"   column="region_code"   />
        <result property="regionLevel"  column="region_level"  />
        <result property="parentId"     column="parent_id"     />
        <result property="status"       column="status"        />
        <result property="sortOrder"    column="sort_order"    />
        <result property="parentName"   column="parent_name"   />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectRegionVo">
        select region_id, region_name, region_code, region_level, parent_id, status, sort_order, create_by, create_time, update_by, update_time, remark
        from gc_region
    </sql>

    <select id="selectRegionList" parameterType="GcRegion" resultMap="GcRegionResult">
        <include refid="selectRegionVo"/>
        where 1=1
        <if test="regionId != null">
            AND region_id = #{regionId}
        </if>
        <if test="regionName != null and regionName != ''">
            AND region_name like concat('%', #{regionName}, '%')
        </if>
        <if test="regionCode != null and regionCode != ''">
            AND region_code = #{regionCode}
        </if>
        <if test="regionLevel != null">
            AND region_level = #{regionLevel}
        </if>
        <if test="parentId != null">
            AND parent_id = #{parentId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        order by sort_order, region_code
    </select>

    <select id="selectProvinceList" resultMap="GcRegionResult">
        <include refid="selectRegionVo"/>
        where region_level = 1 and status = '0'
        order by sort_order
    </select>

    <select id="selectRegionListByParentId" resultMap="GcRegionResult">
        <include refid="selectRegionVo"/>
        where parent_id = #{parentId} 
        <if test="regionLevel != null">
            AND region_level = #{regionLevel}
        </if>
        and status = '0'
        order by sort_order
    </select>

    <select id="selectRegionById" parameterType="Long" resultMap="GcRegionResult">
        select r.region_id, r.region_name, r.region_code, r.region_level, r.parent_id, r.status, r.sort_order,
            r.create_by, r.create_time, r.update_by, r.update_time, r.remark,
            (select region_name from gc_region where region_id = r.parent_id) parent_name
        from gc_region r
        where r.region_id = #{regionId}
    </select>

    <select id="hasChildByRegionId" parameterType="Long" resultType="int">
        select count(1) from gc_region
        where parent_id = #{regionId} limit 1
    </select>

    <select id="checkRegionCodeUnique" resultMap="GcRegionResult">
        <include refid="selectRegionVo"/>
        where region_code = #{regionCode}
        <if test="regionId != null">
            and region_id != #{regionId}
        </if>
        limit 1
    </select>

    <select id="checkRegionExistSamplingSite" parameterType="Long" resultType="int">
        select count(1) from gc_sampling_site where region_id = #{regionId} and status = '0'
    </select>

    <select id="checkRegionExistSurveyor" parameterType="Long" resultType="int">
        select count(1) from gc_surveyor where region_id = #{regionId} and status = '0'
    </select>

    <insert id="insertRegion" parameterType="GcRegion" useGeneratedKeys="true" keyProperty="regionId">
        insert into gc_region(
            <if test="regionName != null and regionName != ''">region_name,</if>
            <if test="regionCode != null and regionCode != ''">region_code,</if>
            <if test="regionLevel != null">region_level,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="regionName != null and regionName != ''">#{regionName},</if>
            <if test="regionCode != null and regionCode != ''">#{regionCode},</if>
            <if test="regionLevel != null">#{regionLevel},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateRegion" parameterType="GcRegion">
        update gc_region
        <set>
            <if test="regionName != null and regionName != ''">region_name = #{regionName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where region_id = #{regionId}
    </update>

    <delete id="deleteRegionById" parameterType="Long">
        delete from gc_region where region_id = #{regionId}
    </delete>

</mapper>
